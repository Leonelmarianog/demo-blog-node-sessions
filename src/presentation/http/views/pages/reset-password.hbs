{{> flash}}

<div class="mx-auto max-w-md space-y-6">
  <div class="text-center">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900">Set a new password</h1>
    <p class="mt-1 text-sm text-gray-500">Choose a password you don't use elsewhere.</p>
  </div>

  <form class="space-y-5" action="{{formAction}}" method="post">
    {{#if errors.form}}
      <div class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{{errors.form}}</div>
    {{/if}}
    <div>
      <label for="password" class="block text-sm font-medium text-gray-700">New password</label>
      <input id="password" name="password" type="password" autocomplete="new-password" value="{{values.password}}" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />
      <p class="mt-1 text-xs text-gray-500">At least eight characters.</p>
      {{#if errors.password}}<p class="mt-1 text-xs text-red-600">{{errors.password}}</p>{{/if}}
    </div>

    <div>
      <label for="confirmPassword" class="block text-sm font-medium text-gray-700">Confirm new password</label>
      <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" value="{{values.confirmPassword}}" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />
      {{#if errors.confirmPassword}}<p class="mt-1 text-xs text-red-600">{{errors.confirmPassword}}</p>{{/if}}
    </div>

    <button type="submit" class="cursor-pointer w-full rounded-md bg-brand-500 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-700">Reset password</button>
  </form>

  <p class="text-center text-sm text-gray-600">
    <a href="/login" class="font-medium text-brand-700 hover:text-brand-900">Back to sign in</a>
  </p>
</div>