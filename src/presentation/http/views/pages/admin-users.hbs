{{> flash}}

<div class="space-y-6">
  <h1 class="text-2xl font-bold tracking-tight text-gray-900">Admin Panel</h1>
  {{> admin-nav}}

  <form action="/admin/users" method="get" class="flex flex-wrap items-center gap-3">
    <label for="admin-users-search" class="sr-only">Search users</label>
    <input id="admin-users-search" name="q" type="search" placeholder="Search by name, username, or email…" class="block w-full max-w-xs rounded-md border border-gray-300 px-3 py-1.5 text-sm outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />

    <label for="admin-users-role" class="sr-only">Filter by role</label>
    <select id="admin-users-role" name="role" class="rounded-md border border-gray-300 px-3 py-1.5 text-sm outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500">
      <option value="">All roles</option>
      <option value="reader">Reader</option>
      <option value="author">Author</option>
      <option value="admin">Admin</option>
    </select>

    <label for="admin-users-status" class="sr-only">Filter by status</label>
    <select id="admin-users-status" name="status" class="rounded-md border border-gray-300 px-3 py-1.5 text-sm outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500">
      <option value="">All statuses</option>
      <option value="active">Active</option>
      <option value="unverified">Unverified</option>
      <option value="suspended">Suspended</option>
      <option value="self-deactivated">Self-deactivated</option>
    </select>

    <button type="submit" class="cursor-pointer rounded-md bg-brand-500 px-3 py-1.5 text-sm font-medium text-white transition-colors hover:bg-brand-700">Filter</button>
  </form>

  <p class="mb-3 text-right text-sm text-gray-500">Showing 1,205 results</p>

  <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead>
        <tr class="text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
          <th class="p-4 font-semibold">
            <button type="button" class="group inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 hover:text-gray-900 cursor-pointer">
              User
              <span class="inline-flex flex-col items-center" aria-hidden="true">
                <svg class="h-2.5 w-2.5 text-gray-300 group-hover:text-gray-400" viewBox="0 0 10 10" fill="currentColor"><path d="M5 2L9 7L1 7Z"/></svg>
                <svg class="h-2.5 w-2.5 text-gray-300 group-hover:text-gray-400" viewBox="0 0 10 10" fill="currentColor"><path d="M5 8L1 3L9 3Z"/></svg>
              </span>
            </button>
          </th>
          <th class="p-4 font-semibold">Role</th>
          <th class="p-4 font-semibold">Status</th>
          <th class="p-4 font-semibold">
            <button type="button" class="inline-flex items-center gap-1 text-xs font-semibold uppercase tracking-wide text-gray-900 cursor-pointer" aria-sort="descending">
              Joined
              <span class="inline-flex flex-col items-center" aria-hidden="true">
                <svg class="h-2.5 w-2.5 text-gray-300" viewBox="0 0 10 10" fill="currentColor"><path d="M5 2L9 7L1 7Z"/></svg>
                <svg class="h-2.5 w-2.5 text-brand-700" viewBox="0 0 10 10" fill="currentColor"><path d="M5 8L1 3L9 3Z"/></svg>
              </span>
            </button>
          </th>
          <th class="p-4 text-right font-semibold">Actions</th>
        </tr>
      </thead>
