{{> flash}}

<div class="mx-auto max-w-md space-y-6">
  <div class="text-center">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900">Reset your password</h1>
    <p class="mt-1 text-sm text-gray-500">Enter your email and we'll send you a link to reset it.</p>
  </div>

  <form class="space-y-5" action="/forgot-password" method="post">
    <div>
      <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />
    </div>

    <button type="submit" class="w-full rounded-md bg-brand-500 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-700">Send reset link</button>
  </form>

  <p class="text-center text-sm text-gray-600">
    <a href="/login" class="font-medium text-brand-700 hover:text-brand-900">Back to sign in</a>
  </p>
</div>