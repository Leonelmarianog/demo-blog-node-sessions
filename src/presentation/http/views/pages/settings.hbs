<div class="space-y-8">
  <h1 class="text-2xl font-bold tracking-tight text-gray-900">Settings</h1>

  <div class="border-b border-gray-200">
    <nav class="-mb-px flex gap-6" aria-label="Settings">
      <a href="/settings/profile" class="border-b-2 px-1 pb-3 text-sm font-medium {{#if (eq activeSection 'profile')}}border-brand-500 text-brand-700{{else}}border-transparent text-gray-500 hover:text-gray-700{{/if}}">Profile</a>
      <a href="/settings/account" class="border-b-2 px-1 pb-3 text-sm font-medium {{#if (eq activeSection 'account')}}border-brand-500 text-brand-700{{else}}border-transparent text-gray-500 hover:text-gray-700{{/if}}">Account</a>
    </nav>
  </div>

  {{#if (eq activeSection 'profile')}}
    <form class="space-y-6" action="/settings/profile" method="post">
      <div>
        <span class="block text-sm font-medium text-gray-700">Photo</span>
        <div class="mt-2 flex items-center gap-4">
          <div class="flex h-16 w-16 items-center justify-center rounded-full bg-brand-100 text-xl font-semibold text-brand-700">LM</div>
          <div class="flex gap-2">
            <label class="cursor-pointer rounded-md border border-gray-300 px-3 py-1.5 text-sm text-gray-700 transition-colors hover:bg-gray-50">
              Update
              <input type="file" name="photo" class="hidden" />
            </label>
            <button type="button" class="rounded-md border border-gray-300 px-3 py-1.5 text-sm text-gray-700 transition-colors hover:bg-gray-50">Remove</button>
          </div>
        </div>
      </div>

      <div>
        <label for="name" class="block text-sm font-medium text-gray-700">Name</label>
        <input id="name" name="name" type="text" value="Leonel Mariano" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />
        <p class="mt-1 text-xs text-gray-500">Shown on your profile and as the author on your posts.</p>
      </div>

      <div>
        <label for="bio" class="block text-sm font-medium text-gray-700">Short bio</label>
        <textarea id="bio" name="bio" rows="3" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500">Full-stack engineer writing about server-rendered architectures, NestJS, and keeping things simple.</textarea>
        <p class="mt-1 text-xs text-gray-500">Shown on your profile and on your posts.</p>
      </div>

      <div class="flex justify-end">
        <button type="submit" class="cursor-pointer rounded-md bg-brand-500 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-700">Save changes</button>
      </div>
    </form>
  {{else}}
    <form class="space-y-6" action="/settings/account" method="post">
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
        <input id="email" name="email" type="email" value="leonel@example.com" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />
        <p class="mt-1 text-xs text-gray-500">Used to sign in and receive notifications.</p>
      </div>
      <div class="flex justify-end">
        <button type="submit" class="cursor-pointer rounded-md bg-brand-500 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-700">Update email</button>
      </div>
    </form>

    <form class="space-y-6 border-t border-gray-200 pt-6" action="/settings/password" method="post">
      <h2 class="text-sm font-medium text-gray-700">Change password</h2>
      <div>
        <label for="newPassword" class="block text-sm font-medium text-gray-700">New password</label>
        <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />
      </div>
      <div>
        <label for="confirmNewPassword" class="block text-sm font-medium text-gray-700">Confirm new password</label>
        <input id="confirmNewPassword" name="confirmNewPassword" type="password" autocomplete="new-password" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />
      </div>
      <div class="flex justify-end">
        <button type="submit" class="cursor-pointer rounded-md border border-brand-500 px-4 py-2 text-sm font-medium text-brand-700 transition-colors hover:bg-brand-50">Update password</button>
      </div>
    </form>

    <form class="space-y-6 border-t border-gray-200 pt-6" action="/settings/account/deactivate" method="post">
      <h2 class="text-sm font-medium text-gray-700">Deactivate account</h2>
      <p class="text-sm text-gray-500">Temporarily disable your account. Your posts and profile stay hidden until you sign back in to reactivate.</p>
      <div class="flex justify-end">
        <button type="submit" class="cursor-pointer rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:bg-gray-50">Deactivate account</button>
      </div>
    </form>

    <form class="space-y-6 border-t border-gray-200 pt-6" action="/settings/account/delete" method="post">
      <h2 class="text-sm font-medium text-gray-700">Delete account</h2>
      <p class="text-sm text-gray-500">Permanently remove your account and all your posts. This cannot be undone.</p>
      <div class="flex justify-end">
        <button type="submit" class="cursor-pointer rounded-md border border-red-300 px-4 py-2 text-sm font-medium text-red-700 transition-colors hover:bg-red-50">Delete account</button>
      </div>
    </form>
  {{/if}}
</div>