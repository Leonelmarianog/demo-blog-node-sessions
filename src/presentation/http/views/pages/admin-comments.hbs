        <span>by <a href="/u/troll-99" class="text-brand-700 hover:text-brand-900">troll-99</a></span>
        <span>flagged by <a href="/u/mike-ross" class="text-brand-700 hover:text-brand-900">mike-ross</a> <time>6h ago</time></span>
        <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 font-medium text-gray-700">Abuse</span>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
        <button type="button" class="cursor-pointer text-gray-600 hover:text-gray-900">Approve</button>
        <span class="text-gray-300">&middot;</span>
        <button type="button" class="cursor-pointer text-gray-600 hover:text-gray-900">Reject</button>
        <span class="text-gray-300">&middot;</span>
        <a href="/posts/session-cookies-vs-jwt" class="text-gray-600 hover:text-gray-900">View on post</a>
        <span class="text-gray-300">&middot;</span>
        <button type="button" class="cursor-pointer text-red-600 hover:text-red-800">Delete</button>
      </div>
    </li>

    <li class="p-4">
      <p class="text-sm text-gray-900">Make $5000/day working from home! Click here now: cash-fast.example</p>
      <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500">
        <span>on <a href="/posts/tailwind-v4-css-first-config" class="font-medium text-brand-700 hover:text-brand-900">Tailwind v4's CSS-first config in a NestJS app</a></span>
        <span>by <a href="/u/free-cash" class="text-brand-700 hover:text-brand-900">free-cash</a></span>
        <span>flagged by Spam filter <time>1d ago</time></span>
        <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 font-medium text-gray-700">Spam</span>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
        <button type="button" class="cursor-pointer text-gray-600 hover:text-gray-900">Approve</button>
        <span class="text-gray-300">&middot;</span>
        <button type="button" class="cursor-pointer text-gray-600 hover:text-gray-900">Reject</button>
        <span class="text-gray-300">&middot;</span>
        <a href="/posts/tailwind-v4-css-first-config" class="text-gray-600 hover:text-gray-900">View on post</a>
        <span class="text-gray-300">&middot;</span>
        <button type="button" class="cursor-pointer text-red-600 hover:text-red-800">Delete</button>
      </div>
    </li>

    <li class="p-4">
      <p class="text-sm text-gray-900">First! &mdash; also way too long, nobody's reading all that.</p>
      <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-gray-500">
        <span>on <a href="/posts/argon2id-beginners-guide" class="font-medium text-brand-700 hover:text-brand-900">A beginner's guide to Argon2id</a></span>
        <span>by <a href="/u/anon-42" class="text-brand-700 hover:text-brand-900">anon-42</a></span>
        <span>flagged by <a href="/u/sarah-chen" class="text-brand-700 hover:text-brand-900">sarah-chen</a> <time>2d ago</time></span>
        <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 font-medium text-gray-700">Inappropriate</span>
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
        <button type="button" class="cursor-pointer text-gray-600 hover:text-gray-900">Approve</button>
        <span class="text-gray-300">&middot;</span>
        <button type="button" class="cursor-pointer text-gray-600 hover:text-gray-900">Reject</button>
        <span class="text-gray-300">&middot;</span>
        <a href="/posts/argon2id-beginners-guide" class="text-gray-600 hover:text-gray-900">View on post</a>
        <span class="text-gray-300">&middot;</span>
        <button type="button" class="cursor-pointer text-red-600 hover:text-red-800">Delete</button>
      </div>
    </li>
  </ul>

  {{> pagination prevDisabled=true currentPage=1 totalPages=2 nextHref="/admin/comments?page=2&status=awaiting"}}
</div>