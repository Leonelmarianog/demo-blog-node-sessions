<div class="space-y-8">
  <div class="border-b border-gray-200">
    <nav class="-mb-px flex gap-6" aria-label="Search results">
      <a href="/search/posts" class="border-b-2 px-1 pb-3 text-sm font-medium {{#if (eq activeTab 'posts')}}border-brand-500 text-brand-700{{else}}border-transparent text-gray-500 hover:text-gray-700{{/if}}">Posts</a>
      <a href="/search/tags" class="border-b-2 px-1 pb-3 text-sm font-medium {{#if (eq activeTab 'tags')}}border-brand-500 text-brand-700{{else}}border-transparent text-gray-500 hover:text-gray-700{{/if}}">Tags</a>
    </nav>
  </div>

  {{#if (eq activeTab 'posts')}}
    <p class="text-sm text-gray-500">4 results</p>

    <div class="space-y-6">
      {{> post-card
        href="/posts/building-a-server-rendered-blog"
        title="Building a server-rendered blog with NestJS and Handlebars"
        excerpt="Why server-rendering still makes sense for a content-heavy blog, and how NestJS plus Handlebars keep the stack simple without giving up on a clean, layered architecture."
        author="Leonel Mariano"
        authorHref="/u/leonel-mariano"
        dateIso="2026-08-10"
        dateLabel="Aug 10, 2026"
        readTime="6"
        tags=(array "nestjs" "handlebars" "architecture")
      }}

      {{> post-card
        href="/posts/session-cookies-vs-jwt"
        title="Session cookies vs JWT: picking an auth strategy"
        excerpt="A pragmatic look at where each approach fits, the threat model that actually matters for a blog, and why this stack leans toward server-side sessions stored in Redis."
        author="Leonel Mariano"
        authorHref="/u/leonel-mariano"
        dateIso="2026-08-06"
        dateLabel="Aug 6, 2026"
        readTime="8"
        tags=(array "auth" "security" "sessions")
      }}

      {{> post-card
        href="/posts/clean-architecture-on-the-server"
        title="Clean architecture on the server, without the ceremony"
        excerpt="Domain, application, infrastructure, presentation — kept just strict enough to keep the codebase honest as it grows, without drowning a small app in abstraction."
        author="Leonel Mariano"
        authorHref="/u/leonel-mariano"
        dateIso="2026-07-15"
        dateLabel="Jul 15, 2026"
        readTime="7"
        tags=(array "architecture" "domain")
      }}

      {{> post-card
        href="/posts/tailwind-v4-css-first-config"
        title="Tailwind v4's CSS-first config in a NestJS app"
        excerpt="No tailwind.config.js, no content array — just an @import and an @theme block. How the new CSS-first setup fits cleanly into a server-rendered build pipeline."
        author="Leonel Mariano"
        authorHref="/u/leonel-mariano"
        dateIso="2026-07-28"
        dateLabel="Jul 28, 2026"
        readTime="4"
        tags=(array "tailwind" "css")
      }}
    </div>

    {{> pagination prevDisabled=true currentPage=1 totalPages=2 nextHref="/search/posts?page=2"}}
  {{else}}
    <p class="text-sm text-gray-500">3 results</p>

    <div class="space-y-4">
      <a href="/tag/nestjs" class="block rounded-lg border border-gray-200 bg-white p-5 transition-colors hover:border-brand-500">
        <div class="flex items-center justify-between">
          <span class="text-lg font-semibold text-gray-900">#nestjs</span>
          <span class="text-sm text-gray-500">12 posts</span>
        </div>
        <p class="mt-1 text-sm text-gray-500">Posts tagged nestjs.</p>
      </a>

      <a href="/tag/architecture" class="block rounded-lg border border-gray-200 bg-white p-5 transition-colors hover:border-brand-500">
        <div class="flex items-center justify-between">
          <span class="text-lg font-semibold text-gray-900">#architecture</span>
          <span class="text-sm text-gray-500">8 posts</span>
        </div>
        <p class="mt-1 text-sm text-gray-500">Posts tagged architecture.</p>
      </a>

      <a href="/tag/auth" class="block rounded-lg border border-gray-200 bg-white p-5 transition-colors hover:border-brand-500">
        <div class="flex items-center justify-between">
          <span class="text-lg font-semibold text-gray-900">#auth</span>
          <span class="text-sm text-gray-500">5 posts</span>
        </div>
        <p class="mt-1 text-sm text-gray-500">Posts tagged auth.</p>
      </a>
    </div>
  {{/if}}
</div>
