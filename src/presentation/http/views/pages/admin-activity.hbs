{{> flash}}

<div class="space-y-6">
  <h1 class="text-2xl font-bold tracking-tight text-gray-900">Admin Panel</h1>
  {{> admin-nav}}

  <form action="/admin/activity" method="get" class="flex flex-wrap items-center gap-3">
    <label for="admin-activity-actor" class="sr-only">Search by actor</label>
    <input id="admin-activity-actor" name="actor" type="search" placeholder="Search by username…" class="block w-full max-w-xs rounded-md border border-gray-300 px-3 py-1.5 text-sm outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />

    <label for="admin-activity-type" class="sr-only">Filter by event type</label>
    <select id="admin-activity-type" name="type" class="rounded-md border border-gray-300 px-3 py-1.5 text-sm outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500">
      <option value="">All types</option>
      <option value="users">Users</option>
      <option value="posts">Posts</option>
      <option value="comments">Comments</option>
      <option value="tags">Tags</option>
    </select>

    <label for="admin-activity-from" class="sr-only">From date</label>
    <input id="admin-activity-from" name="from" type="date" class="rounded-md border border-gray-300 px-3 py-1.5 text-sm text-gray-500 outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />

    <span class="text-gray-400" aria-hidden="true">&rarr;</span>

    <label for="admin-activity-to" class="sr-only">To date</label>
    <input id="admin-activity-to" name="to" type="date" class="rounded-md border border-gray-300 px-3 py-1.5 text-sm text-gray-500 outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />

    <label class="inline-flex items-center gap-2 text-sm text-gray-600">
      <input type="checkbox" name="adminOnly" value="true" class="rounded border-gray-300 text-brand-600 focus:ring-brand-500" />
      Admin actions only
    </label>

    <button type="submit" class="cursor-pointer rounded-md bg-brand-500 px-3 py-1.5 text-sm font-medium text-white transition-colors hover:bg-brand-700">Filter</button>
  </form>

  <p class="mb-3 text-right text-sm text-gray-500">Showing 248 results</p>

  <ul class="divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white">
    <li class="p-4">
