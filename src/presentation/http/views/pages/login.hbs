{{> flash}}

<div class="mx-auto max-w-md space-y-6">
  <div class="text-center">
    <h1 class="text-2xl font-bold tracking-tight text-gray-900">Sign in</h1>
    <p class="mt-1 text-sm text-gray-500">Welcome back. Sign in to manage your posts.</p>
  </div>

  <form class="space-y-5" action="/login" method="post">
    {{#if errors.form}}
      <div class="rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">{{errors.form}}</div>
    {{/if}}
    <div>
      <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" value="{{values.email}}" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />
      {{#if errors.email}}<p class="mt-1 text-xs text-red-600">{{errors.email}}</p>{{/if}}
    </div>

    <div>
      <label for="password" class="block text-sm font-medium text-gray-700">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" class="mt-1 block w-full rounded-md border border-gray-300 px-3 py-2 text-sm outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />
      {{#if errors.password}}<p class="mt-1 text-xs text-red-600">{{errors.password}}</p>{{/if}}
    </div>

    <div class="text-right">
      <a href="/forgot-password" class="text-sm text-brand-700 hover:text-brand-900">Forgot password?</a>
    </div>

    <div class="flex items-center">
      <input id="rememberMe" name="rememberMe" type="checkbox" value="on" class="h-4 w-4 rounded border-gray-300 text-brand-600 focus:ring-brand-500" />
      <label for="rememberMe" class="ml-2 block text-sm text-gray-700">Remember me</label>
    </div>

    <button type="submit" class="cursor-pointer w-full rounded-md bg-brand-500 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-brand-700">Sign in</button>
  </form>

  <p class="text-center text-sm text-gray-600">
    New here?
    <a href="/register" class="font-medium text-brand-700 hover:text-brand-900">Create an account</a>
  </p>
</div>