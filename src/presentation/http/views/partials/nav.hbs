<nav class="flex items-center gap-4 text-sm text-gray-600">
  <a href="/" class="hover:text-gray-900">Home</a>
  {{#if currentUser}}
    <span class="text-gray-500">Signed in as {{currentUser.username}}</span>
    <form class="inline" action="/logout" method="post">
      <button type="submit" class="cursor-pointer hover:text-gray-900">Log out</button>
    </form>
  {{else}}
    <a href="/login" class="hover:text-gray-900">Login</a>
    <a href="/register" class="hover:text-gray-900">Register</a>
  {{/if}}
</nav>