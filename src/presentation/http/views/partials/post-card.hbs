<article class="rounded-lg border border-gray-200 bg-white p-6 transition-colors hover:border-brand-500">
  <h2 class="text-xl font-semibold text-gray-900">
    <a href="{{href}}" class="hover:text-brand-700">{{title}}</a>
  </h2>
  <p class="mt-2 leading-relaxed text-gray-600">{{excerpt}}</p>
  <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-500">
    <span class="font-medium text-gray-700">{{author}}</span>
    <span aria-hidden="true">&middot;</span>
    <time datetime="{{dateIso}}">{{dateLabel}}</time>
    <span aria-hidden="true">&middot;</span>
    <span>{{readTime}} min read</span>
  </div>
  <div class="mt-3 flex flex-wrap gap-2">
    {{#each tags}}<span class="inline-flex items-center rounded-full bg-brand-50 px-2.5 py-0.5 text-xs font-medium text-brand-700">{{this}}</span>{{/each}}
  </div>
</article>
